<Window x:Class="Ngr.Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Ngr.Launcher.App.ViewModels"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="NGR Launcher"
        Width="1280"
        Height="820"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
      <Setter Property="Foreground" Value="#F06A6A" />
    </Style>

    <Style x:Key="ActivityButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="52" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}">
              <Grid>
                <Border x:Name="Marker"
                        Width="2"
                        Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed" />
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
              <Trigger Property="Tag" Value="Active">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SidebarListItemStyle" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="4,1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="3">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SidebarHeaderStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="LabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="EditorSectionStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinHeight" Value="31" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="MinHeight" Value="31" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
      <Setter Property="RowBackground" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="RowHeight" Value="42" />
      <Setter Property="ColumnHeaderHeight" Value="34" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="Menu">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <DataTemplate x:Key="DashboardSidebarTemplate" DataType="{x:Type vm:DashboardViewModel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="42" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
          <TextBlock Text="RUN PROFILES"
                     Style="{StaticResource SidebarHeaderStyle}"
                     VerticalAlignment="Center"
                     Margin="12,0" />
        </Border>
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Profiles}"
                 SelectedItem="{Binding SelectedProfile}"
                 DisplayMemberPath="Name"
                 ItemContainerStyle="{StaticResource SidebarListItemStyle}"
                 Margin="0,4" />
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="8">
          <Button Command="{Binding LaunchCommand}"
                  Style="{StaticResource PrimaryButtonStyle}"
                  HorizontalAlignment="Stretch"
                  ToolTip="Run selected profile">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <ui:SymbolIcon Symbol="Run20" Margin="0,0,6,0" />
              <TextBlock Text="Run selected" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ToolsSidebarTemplate" DataType="{x:Type vm:ToolLibraryViewModel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="42" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
          <Grid Margin="8,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="TOOLS" Style="{StaticResource SidebarHeaderStyle}" VerticalAlignment="Center" Margin="4,0" />
            <Button Grid.Column="1"
                    Command="{Binding NewCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Padding="6"
                    Margin="0,5,4,5"
                    ToolTip="New tool">
              <ui:SymbolIcon Symbol="AddSquare20" />
            </Button>
            <Button Grid.Column="2"
                    Command="{Binding DeleteCommand}"
                    Style="{StaticResource DangerButtonStyle}"
                    Padding="6"
                    Margin="0,5,0,5"
                    ToolTip="Delete selected tool">
              <ui:SymbolIcon Symbol="SquareDismiss20" />
            </Button>
          </Grid>
        </Border>
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Tools}"
                 SelectedItem="{Binding SelectedTool}"
                 DisplayMemberPath="Name"
                 ItemContainerStyle="{StaticResource SidebarListItemStyle}"
                 Margin="0,4" />
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,10,10,12">
          <StackPanel>
            <TextBlock Text="TEMPLATE" Style="{StaticResource SidebarHeaderStyle}" Margin="2,0,0,6" />
            <ComboBox ItemsSource="{Binding Templates}"
                      SelectedItem="{Binding SelectedTemplate}"
                      DisplayMemberPath="Name"
                      Margin="0,0,0,8" />
            <Button Content="Apply template"
                    Command="{Binding ApplyTemplateCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    HorizontalAlignment="Stretch" />
          </StackPanel>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ProfilesSidebarTemplate" DataType="{x:Type vm:ProfilesViewModel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="42" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
          <Grid Margin="8,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="PROFILES" Style="{StaticResource SidebarHeaderStyle}" VerticalAlignment="Center" Margin="4,0" />
            <Button Grid.Column="1"
                    Command="{Binding NewCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Padding="6"
                    Margin="0,5,4,5"
                    ToolTip="New profile">
              <ui:SymbolIcon Symbol="AddSquare20" />
            </Button>
            <Button Grid.Column="2"
                    Command="{Binding DeleteCommand}"
                    Style="{StaticResource DangerButtonStyle}"
                    Padding="6"
                    Margin="0,5,0,5"
                    ToolTip="Delete selected profile">
              <ui:SymbolIcon Symbol="SquareDismiss20" />
            </Button>
          </Grid>
        </Border>
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Profiles}"
                 SelectedItem="{Binding SelectedProfile}"
                 DisplayMemberPath="Name"
                 ItemContainerStyle="{StaticResource SidebarListItemStyle}"
                 Margin="0,4" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SettingsSidebarTemplate" DataType="{x:Type vm:SettingsViewModel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="42" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
          <TextBlock Text="SETTINGS"
                     Style="{StaticResource SidebarHeaderStyle}"
                     VerticalAlignment="Center"
                     Margin="12,0" />
        </Border>
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12">
          <StackPanel>
            <TextBlock Text="APPEARANCE" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,6" />
            <TextBlock Text="{Binding Theme}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12">
          <StackPanel>
            <TextBlock Text="STARTUP" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,6" />
            <TextBlock Text="Windows startup wiring is not implemented yet."
                       Style="{StaticResource SecondaryTextStyle}" />
          </StackPanel>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DashboardEditorTemplate" DataType="{x:Type vm:DashboardViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />
              <TextBlock Text="Launch profiles, watch active runs, and cancel pending steps."
                         Style="{StaticResource SecondaryTextStyle}"
                         Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
              <Button Command="{Binding CancelCommand}"
                      Style="{StaticResource ToolbarButtonStyle}"
                      Margin="0,0,8,0"
                      Content="Cancel selected" />
              <Button Command="{Binding LaunchCommand}"
                      Style="{StaticResource PrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Run20" Margin="0,0,6,0" />
                  <TextBlock Text="Run profile" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <Border Grid.Row="1"
                  Style="{StaticResource EditorSectionStyle}"
                  Margin="0,20,0,16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Selected profile"
                         Style="{StaticResource LabelStyle}"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0" />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding Profiles}"
                        SelectedItem="{Binding SelectedProfile}"
                        DisplayMemberPath="Name"
                        MinWidth="260"
                        HorizontalAlignment="Left" />
              <TextBlock Grid.Column="2"
                         Text="{Binding StatusMessage}"
                         Style="{StaticResource SecondaryTextStyle}"
                         VerticalAlignment="Center"
                         Margin="16,0,0,0" />
            </Grid>
          </Border>

          <TextBlock Grid.Row="2"
                     Text="RECENT RUNS"
                     Style="{StaticResource SidebarHeaderStyle}"
                     Margin="0,2,0,8" />

          <ListBox Grid.Row="3"
                   ItemsSource="{Binding Sessions}"
                   SelectedItem="{Binding SelectedSession}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Root"
                              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              CornerRadius="4"
                              Padding="14">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Status}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12" />
                  </Grid>
                  <TextBlock Text="{Binding Id}"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             FontSize="10.5"
                             Margin="0,2,0,8" />
                  <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="2*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding ToolName}" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding DelayBeforeSeconds, StringFormat={}{0}s}"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                          <TextBlock Grid.Column="2" Text="{Binding Status}" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="3"
                                     Text="{Binding Error}"
                                     Foreground="#F06A6A"
                                     TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate x:Key="ToolsEditorTemplate" DataType="{x:Type vm:ToolLibraryViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Tool editor" Style="{StaticResource PageTitleStyle}" />
              <TextBlock Text="Configure an application or command. Saved tools stay reusable across profiles."
                         Style="{StaticResource SecondaryTextStyle}"
                         Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
              <Button Command="{Binding LaunchCommand}"
                      Style="{StaticResource ToolbarButtonStyle}"
                      Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Run20" Margin="0,0,6,0" />
                  <TextBlock Text="Run now" />
                </StackPanel>
              </Button>
              <Button Command="{Binding SaveCommand}"
                      Style="{StaticResource PrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Save20" Margin="0,0,6,0" />
                  <TextBlock Text="Save tool" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <Border Grid.Row="1"
                  Style="{StaticResource EditorSectionStyle}"
                  Margin="0,20,0,12">
            <StackPanel>
              <TextBlock Text="IDENTITY" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,12" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Text="ID" Style="{StaticResource LabelStyle}" />
                  <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Name" Style="{StaticResource LabelStyle}" />
                  <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                  <TextBlock Text="Kind" Style="{StaticResource LabelStyle}" />
                  <ComboBox ItemsSource="{Binding ToolKinds}" SelectedItem="{Binding Kind}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                  <TextBlock Text="Working directory" Style="{StaticResource LabelStyle}" />
                  <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource EditorSectionStyle}">
              <StackPanel>
                <TextBlock Text="APPLICATION" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,12" />
                <TextBlock Text="Target" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                <TextBlock Text="Arguments" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource EditorSectionStyle}">
              <StackPanel>
                <TextBlock Text="COMMAND" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,12" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Shell" Style="{StaticResource LabelStyle}" />
                    <ComboBox ItemsSource="{Binding ShellKinds}" SelectedItem="{Binding Shell}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Window mode" Style="{StaticResource LabelStyle}" />
                    <ComboBox ItemsSource="{Binding WindowModes}" SelectedItem="{Binding WindowMode}" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="Command" Style="{StaticResource LabelStyle}" Margin="0,12,0,0" />
                <TextBox Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                         Height="82"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top" />
                <TextBlock Text="Environment (KEY=VALUE, one per line)"
                           Style="{StaticResource LabelStyle}"
                           Margin="0,12,0,0" />
                <TextBox Text="{Binding EnvironmentText, UpdateSourceTrigger=PropertyChanged}"
                         Height="100"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" />
              </StackPanel>
            </Border>
          </Grid>

          <TextBlock Grid.Row="3"
                     Text="{Binding StatusMessage}"
                     Style="{StaticResource SecondaryTextStyle}"
                     Margin="0,12,0,0" />
        </Grid>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate x:Key="ProfilesEditorTemplate" DataType="{x:Type vm:ProfilesViewModel}">
      <Grid Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Profile editor" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Order reusable tools and set a delay before each launch."
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,4,0,0" />
          </StackPanel>
          <Button Grid.Column="1"
                  Command="{Binding SaveCommand}"
                  Style="{StaticResource PrimaryButtonStyle}"
                  VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Save20" Margin="0,0,6,0" />
              <TextBlock Text="Save profile" />
            </StackPanel>
          </Button>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource EditorSectionStyle}"
                Margin="0,20,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="ID" Style="{StaticResource LabelStyle}" />
              <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Name" Style="{StaticResource LabelStyle}" />
              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource EditorSectionStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="STEPS" Style="{StaticResource SidebarHeaderStyle}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Add step"
                        Command="{Binding AddStepCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,0,6,0" />
                <Button Content="↑"
                        Command="{Binding MoveStepUpCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Width="34"
                        Margin="0,0,6,0"
                        ToolTip="Move selected step up" />
                <Button Content="↓"
                        Command="{Binding MoveStepDownCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Width="34"
                        Margin="0,0,6,0"
                        ToolTip="Move selected step down" />
                <Button Content="Remove"
                        Command="{Binding RemoveStepCommand}"
                        Style="{StaticResource DangerButtonStyle}" />
              </StackPanel>
            </Grid>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Steps}"
                      SelectedItem="{Binding SelectedStep}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Tool" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ComboBox ItemsSource="{Binding DataContext.AvailableTools, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                DisplayMemberPath="Name"
                                SelectedValuePath="Id"
                                SelectedValue="{Binding ToolId, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0"
                                MinHeight="28" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Delay before launch (seconds)"
                                    Width="220"
                                    Binding="{Binding DelayBeforeSeconds, UpdateSourceTrigger=PropertyChanged}" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource SecondaryTextStyle}"
                   Margin="0,12,0,0" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SettingsEditorTemplate" DataType="{x:Type vm:SettingsViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
              <TextBlock Text="Appearance and Windows integration preferences."
                         Style="{StaticResource SecondaryTextStyle}"
                         Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    VerticalAlignment="Bottom">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Save20" Margin="0,0,6,0" />
                <TextBlock Text="Save settings" />
              </StackPanel>
            </Button>
          </Grid>

          <Border Grid.Row="1"
                  Style="{StaticResource EditorSectionStyle}"
                  Margin="0,20,0,12"
                  MaxWidth="720"
                  HorizontalAlignment="Left">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Choose how NGR follows Windows colors."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,4,20,0" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Theme" Style="{StaticResource LabelStyle}" />
                <ComboBox ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding Theme}"
                          Width="220"
                          HorizontalAlignment="Left" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="2"
                  Style="{StaticResource EditorSectionStyle}"
                  MaxWidth="720"
                  HorizontalAlignment="Left">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Startup" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Windows startup integration."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,4,20,0" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <CheckBox Content="Start NGR Launcher with Windows"
                          IsChecked="{Binding StartWithWindows}" />
                <TextBlock Text="The preference is saved, but Windows startup registration is not wired yet."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,8,0,0" />
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Grid.Row="3"
                     Text="{Binding StatusMessage}"
                     Style="{StaticResource SecondaryTextStyle}"
                     Margin="0,12,0,0" />
        </Grid>
      </ScrollViewer>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="30" />
      <RowDefinition Height="*" />
      <RowDefinition Height="23" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ui:SymbolIcon Symbol="Rocket24"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       ToolTip="NGR Launcher" />

        <Menu Grid.Column="1" VerticalAlignment="Stretch">
          <MenuItem Header="View">
            <MenuItem Header="Dashboard"
                      Command="{Binding NavigateCommand}"
                      CommandParameter="Dashboard" />
            <MenuItem Header="Tool Library"
                      Command="{Binding NavigateCommand}"
                      CommandParameter="Tools" />
            <MenuItem Header="Profiles"
                      Command="{Binding NavigateCommand}"
                      CommandParameter="Profiles" />
            <Separator />
            <MenuItem Header="Settings"
                      Command="{Binding NavigateCommand}"
                      CommandParameter="Settings" />
          </MenuItem>
          <MenuItem Header="Run">
            <MenuItem Header="Run selected profile"
                      Command="{Binding Dashboard.LaunchCommand}" />
            <MenuItem Header="Cancel selected run"
                      Command="{Binding Dashboard.CancelCommand}" />
          </MenuItem>
        </Menu>

        <TextBlock Grid.Column="2"
                   Text="NGR Launcher"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   FontSize="11.5"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center" />

        <TextBlock Grid.Column="3"
                   Text="{Binding CurrentTitle}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   FontSize="11"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="52" />
        <ColumnDefinition Width="246" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,4">
            <Button Command="{Binding NavigateCommand}"
                    CommandParameter="Settings"
                    ToolTip="Settings">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ActivityButtonStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentTitle}" Value="Settings">
                      <Setter Property="Tag" Value="Active" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <ui:SymbolIcon Symbol="Settings24" />
            </Button>
          </StackPanel>

          <StackPanel>
            <Button Command="{Binding NavigateCommand}"
                    CommandParameter="Dashboard"
                    ToolTip="Dashboard">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ActivityButtonStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentTitle}" Value="Dashboard">
                      <Setter Property="Tag" Value="Active" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <ui:SymbolIcon Symbol="ContentView24" />
            </Button>

            <Button Command="{Binding NavigateCommand}"
                    CommandParameter="Tools"
                    ToolTip="Tool Library">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ActivityButtonStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentTitle}" Value="Tool Library">
                      <Setter Property="Tag" Value="Active" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <ui:SymbolIcon Symbol="Wrench24" />
            </Button>

            <Button Command="{Binding NavigateCommand}"
                    CommandParameter="Profiles"
                    ToolTip="Profiles">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ActivityButtonStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentTitle}" Value="Profiles">
                      <Setter Property="Tag" Value="Active" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <ui:SymbolIcon Symbol="Library24" />
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Column="1"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0">
        <ContentControl Content="{Binding CurrentPage}">
          <ContentControl.Resources>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DashboardSidebarTemplate}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ToolLibraryViewModel}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolsSidebarTemplate}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProfilesSidebarTemplate}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SettingsSidebarTemplate}" />
            </DataTemplate>
          </ContentControl.Resources>
        </ContentControl>
      </Border>

      <Grid Grid.Column="2" Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="35" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,0"
                    MinWidth="140">
              <TextBlock Text="{Binding CurrentTitle}"
                         VerticalAlignment="Center"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </Border>

            <TextBlock Grid.Column="1"
                       Text="Local workspace"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="12,0" />

            <Button Grid.Column="2"
                    Command="{Binding Dashboard.LaunchCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Margin="0,3,6,3"
                    Padding="8,2"
                    ToolTip="Run selected profile">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Run20" Margin="0,0,5,0" />
                <TextBlock Text="Run" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}">
          <ContentControl.Resources>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DashboardEditorTemplate}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ToolLibraryViewModel}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolsEditorTemplate}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProfilesEditorTemplate}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SettingsEditorTemplate}" />
            </DataTemplate>
          </ContentControl.Resources>
        </ContentControl>
      </Grid>
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource SystemAccentColorPrimaryBrush}">
      <Grid Margin="8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Ellipse Width="6"
                 Height="6"
                 Fill="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                 VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="NGR"
                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="6,0,12,0" />

        <TextBlock Grid.Column="2"
                   Text="Local workspace"
                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                   Opacity="0.88"
                   FontSize="10.5"
                   VerticalAlignment="Center" />

        <TextBlock Grid.Column="3"
                   Text="{Binding CurrentTitle}"
                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                   Opacity="0.88"
                   FontSize="10.5"
                   VerticalAlignment="Center"
                   Margin="0,0,14,0" />

        <TextBlock Grid.Column="4"
                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                   Opacity="0.88"
                   FontSize="10.5"
                   VerticalAlignment="Center">
          <Run Text="Theme: " />
          <Run Text="{Binding Settings.Theme}" />
        </TextBlock>
      </Grid>
    </Border>
  </Grid>
</Window>
