<Window x:Class="Ngr.Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Ngr.Launcher.App.ViewModels"
        xmlns:services="clr-namespace:Ngr.Launcher.App.Services"
        Title="NGR Launcher"
        Icon="/Assets/NgrLauncher.ico"
        Width="1240"
        Height="800"
        MinWidth="1040"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <services:ToolIconConverter x:Key="ToolIconConverter" />

    <DataTemplate x:Key="ProfileSidebarItemTemplate">
      <Grid Margin="2,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" VerticalAlignment="Center">
          <Path Data="{StaticResource CodiconLibrary}" Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="6,0,4,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Steps.Count, StringFormat={}{0} steps}" Style="{StaticResource SecondaryTextStyle}" FontSize="10.5" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ToolSidebarItemTemplate">
      <Grid Margin="2,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="32" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Source="{Binding Converter={StaticResource ToolIconConverter}}" Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="6,0,4,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Kind}" Style="{StaticResource SecondaryTextStyle}" FontSize="10.5" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DashboardSidebarTemplate" DataType="{x:Type vm:DashboardViewModel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="46" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
          <TextBlock Text="PROFILES" Style="{StaticResource SidebarHeaderStyle}" VerticalAlignment="Center" Margin="14,0" />
        </Border>
        <Grid Grid.Row="1">
          <ListBox ItemsSource="{Binding Profiles}"
                   SelectedItem="{Binding SelectedProfile}"
                   ItemTemplate="{StaticResource ProfileSidebarItemTemplate}"
                   ItemContainerStyle="{StaticResource SidebarListItemStyle}"
                   Margin="4,6" />
          <StackPanel Visibility="{Binding HasNoProfiles, Converter={StaticResource BooleanToVisibilityConverter}}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="20">
            <TextBlock Text="No profiles yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Create tools first, then build a profile."
                       Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,6,0,0" />
          </StackPanel>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="10">
          <Button Command="{Binding LaunchCommand}"
                  Style="{StaticResource PrimaryButtonStyle}"
                  HorizontalAlignment="Stretch"
                  ToolTip="Run the selected profile">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Path Data="{StaticResource CodiconPlay}" Style="{StaticResource ButtonIconStyle}" Margin="0,0,8,0" />
              <TextBlock Text="Run selected profile" />
            </StackPanel>
          </Button>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ToolsSidebarTemplate" DataType="{x:Type vm:ToolLibraryViewModel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="46" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
          <Grid Margin="10,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="TOOLS" Style="{StaticResource SidebarHeaderStyle}" VerticalAlignment="Center" Margin="4,0" />
            <Button Grid.Column="1" Command="{Binding NewCommand}" Style="{StaticResource IconButtonStyle}" Margin="1,5,8,5" ToolTip="Create a new tool">
              <Path Data="{StaticResource CodiconAdd}" Style="{StaticResource ButtonIconStyle}" />
            </Button>
            <Button Grid.Column="2" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}" Style="{StaticResource IconButtonStyle}" Foreground="#F06A6A" Margin="1,5,1,5" ToolTip="Delete selected saved tool">
              <Path Data="{StaticResource CodiconTrash}" Style="{StaticResource ButtonIconStyle}" />
            </Button>
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <ListBox ItemsSource="{Binding Tools}"
                   SelectedItem="{Binding SelectedTool}"
                   ItemTemplate="{StaticResource ToolSidebarItemTemplate}"
                   ItemContainerStyle="{StaticResource SidebarListItemStyle}"
                   Margin="4,6" />
          <StackPanel Visibility="{Binding HasNoTools, Converter={StaticResource BooleanToVisibilityConverter}}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="18">
            <TextBlock Text="No saved tools" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Choose an installed app or create a command, then save it here."
                       Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,6,0,0" />
          </StackPanel>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12">
          <StackPanel>
            <TextBlock Text="QUICK START" Style="{StaticResource SidebarHeaderStyle}" Margin="2,0,0,8" />
            <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" Margin="0,0,0,9" />
            <Button Command="{Binding ApplyTemplateCommand}" Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Stretch">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="{StaticResource CodiconAdd}" Style="{StaticResource ButtonIconStyle}" Margin="0,0,8,0" />
                <TextBlock Text="Use template" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ProfilesSidebarTemplate" DataType="{x:Type vm:ProfilesViewModel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="46" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
          <Grid Margin="10,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="PROFILES" Style="{StaticResource SidebarHeaderStyle}" VerticalAlignment="Center" Margin="4,0" />
            <Button Grid.Column="1" Command="{Binding NewCommand}" Style="{StaticResource IconButtonStyle}" Margin="1,5,8,5" ToolTip="Create a new profile">
              <Path Data="{StaticResource CodiconAdd}" Style="{StaticResource ButtonIconStyle}" />
            </Button>
            <Button Grid.Column="2" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}" Style="{StaticResource IconButtonStyle}" Foreground="#F06A6A" Margin="1,5,1,5" ToolTip="Delete selected saved profile">
              <Path Data="{StaticResource CodiconTrash}" Style="{StaticResource ButtonIconStyle}" />
            </Button>
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <ListBox ItemsSource="{Binding Profiles}"
                   SelectedItem="{Binding SelectedProfile}"
                   ItemTemplate="{StaticResource ProfileSidebarItemTemplate}"
                   ItemContainerStyle="{StaticResource SidebarListItemStyle}"
                   Margin="4,6" />
          <StackPanel Visibility="{Binding HasNoProfiles, Converter={StaticResource BooleanToVisibilityConverter}}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="18">
            <TextBlock Text="No saved profiles" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Add tools, arrange the launch order, then save the profile."
                       Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,6,0,0" />
          </StackPanel>
        </Grid>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SettingsSidebarTemplate" DataType="{x:Type vm:SettingsViewModel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="46" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
          <TextBlock Text="SETTINGS" Style="{StaticResource SidebarHeaderStyle}" VerticalAlignment="Center" Margin="14,0" />
        </Border>
        <Border Grid.Row="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="14">
          <StackPanel>
            <TextBlock Text="APPEARANCE" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,7" />
            <TextBlock Text="{Binding Theme}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="14">
          <StackPanel>
            <TextBlock Text="WINDOWS STARTUP" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,7" />
            <TextBlock Text="Managed through the current-user Windows startup entry." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DashboardEditorTemplate" DataType="{x:Type vm:DashboardViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24,28,30" MaxWidth="980" HorizontalAlignment="Left">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />
              <TextBlock Text="Choose a profile, run it, then follow each launch step below."
                         Style="{StaticResource SecondaryTextStyle}"
                         Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
              <Button Command="{Binding CancelCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="1,0,11,0" Content="Cancel pending steps" />
              <Button Command="{Binding LaunchCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="1,0,1,0">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource CodiconPlay}" Style="{StaticResource ButtonIconStyle}" Margin="0,0,8,0" />
                  <TextBlock Text="Run profile" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Style="{StaticResource EditorSectionStyle}" Margin="0,22,0,18" Visibility="{Binding HasProfiles, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="READY TO RUN" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding SelectedProfile.Name}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Select another profile from the sidebar at any time."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,5,0,0" />
              </StackPanel>
              <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedProfile.Steps.Count, StringFormat={}{0} launch steps}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </Border>
            </Grid>
          </Border>

          <Border Grid.Row="1" Style="{StaticResource EditorSectionStyle}" Margin="0,22,0,18" Visibility="{Binding HasNoProfiles, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Text="Nothing to run yet" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Create and test at least one Tool, then create a Profile that contains the tools you want to launch together."
                         Style="{StaticResource SecondaryTextStyle}"
                         TextWrapping="Wrap"
                         Margin="0,7,0,0" />
            </StackPanel>
          </Border>

          <Grid Grid.Row="2" Margin="2,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="RUN HISTORY" Style="{StaticResource SidebarHeaderStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
          </Grid>

          <Grid Grid.Row="3">
            <Border Visibility="{Binding HasNoSessions, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
              <StackPanel>
                <TextBlock Text="No runs yet" FontWeight="SemiBold" />
                <TextBlock Text="Run a profile to see its progress and result here." Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,0" />
              </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding Sessions}"
                     SelectedItem="{Binding SelectedSession}"
                     Visibility="{Binding HasSessions, Converter={StaticResource BooleanToVisibilityConverter}}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource EditorSectionStyle}" Margin="0,0,0,10">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" FontSize="14" />
                        <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="7" Padding="9,4">
                          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                      </Grid>
                      <ItemsControl ItemsSource="{Binding Steps}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,7,0,4">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="2*" />
                                  <ColumnDefinition Width="100" />
                                  <ColumnDefinition Width="120" />
                                  <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ToolName}" />
                                <TextBlock Grid.Column="1" Text="{Binding DelayBeforeSeconds, StringFormat={}{0}s delay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Status}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="{Binding Error}" Foreground="#F06A6A" TextWrapping="Wrap" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate x:Key="ToolsEditorTemplate" DataType="{x:Type vm:ToolLibraryViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24,28,30" MaxWidth="980" HorizontalAlignment="Left">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Tool Library" Style="{StaticResource PageTitleStyle}" />
                <Border Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="9,4"
                        Margin="10,1,0,0"
                        VerticalAlignment="Top">
                  <TextBlock Text="Unsaved changes" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                </Border>
              </StackPanel>
              <TextBlock Text="Choose an installed application or define a command, test it, then save it for reuse."
                         Style="{StaticResource SecondaryTextStyle}"
                         Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
              <Button Command="{Binding LaunchCommand}" IsEnabled="{Binding CanRun}" Style="{StaticResource ToolbarButtonStyle}" Margin="1,0,11,0">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource CodiconPlay}" Style="{StaticResource ButtonIconStyle}" Margin="0,0,8,0" />
                  <TextBlock Text="Test run" />
                </StackPanel>
              </Button>
              <Button Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Style="{StaticResource PrimaryButtonStyle}" Margin="1,0,1,0">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource CodiconSave}" Style="{StaticResource ButtonIconStyle}" Margin="0,0,8,0" />
                  <TextBlock Text="Save changes" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Style="{StaticResource EditorSectionStyle}" Margin="0,22,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Name" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Use a human-readable name. NGR manages its internal identifier automatically."
                           Style="{StaticResource SecondaryTextStyle}"
                           FontSize="11"
                           Margin="2,7,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Type" Style="{StaticResource LabelStyle}" />
                <ComboBox ItemsSource="{Binding ToolKinds}" SelectedItem="{Binding Kind}" />
                <TextBlock Text="Application opens a Windows app/file. Command runs shell text."
                           Style="{StaticResource SecondaryTextStyle}"
                           FontSize="11"
                           Margin="2,7,0,0" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="2" Style="{StaticResource EditorSectionStyle}" Visibility="{Binding IsApplication, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Text="APPLICATION" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,13" />
              <TextBlock Text="App, shortcut, file, or URI" Style="{StaticResource LabelStyle}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" Command="{Binding BrowseTargetCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="15,6" Margin="1" Content="Choose app…" />
              </Grid>
              <TextBlock Text="Choose from installed apps first. If Windows does not expose it there, use the picker’s Browse file fallback. URI targets such as msteams: are also supported."
                         Style="{StaticResource SecondaryTextStyle}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Margin="2,7,0,13" />
              <TextBlock Text="Arguments (optional)" Style="{StaticResource LabelStyle}" />
              <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Border>

          <Border Grid.Row="2" Style="{StaticResource EditorSectionStyle}" Visibility="{Binding IsCommand, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Text="COMMAND" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,13" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="18" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Shell" Style="{StaticResource LabelStyle}" />
                  <ComboBox ItemsSource="{Binding ShellKinds}" SelectedItem="{Binding Shell}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Window behavior" Style="{StaticResource LabelStyle}" />
                  <ComboBox ItemsSource="{Binding WindowModes}" SelectedItem="{Binding WindowMode}" />
                </StackPanel>
              </Grid>
              <TextBlock Text="Command" Style="{StaticResource LabelStyle}" Margin="0,13,0,0" />
              <TextBox Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" Height="92" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
              <TextBlock Text="Environment variables (optional, KEY=VALUE per line)" Style="{StaticResource LabelStyle}" Margin="0,13,0,0" />
              <TextBox Text="{Binding EnvironmentText, UpdateSourceTrigger=PropertyChanged}" Height="92" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
          </Border>

          <Border Grid.Row="3" Style="{StaticResource EditorSectionStyle}" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="WORKING DIRECTORY" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,13" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" Command="{Binding BrowseWorkingDirectoryCommand}" Style="{StaticResource ToolbarButtonStyle}" Padding="15,6" Margin="1" Content="Choose folder…" />
              </Grid>
              <TextBlock Text="Optional. Set this only when the app or command expects to start inside a specific folder."
                         Style="{StaticResource SecondaryTextStyle}"
                         FontSize="11"
                         Margin="2,7,0,0" />
            </StackPanel>
          </Border>

          <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
              <StackPanel>
                <TextBlock Text="CONFIGURATION" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
              <StackPanel>
                <TextBlock Text="LAST ACTION" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate x:Key="ProfilesEditorTemplate" DataType="{x:Type vm:ProfilesViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24,28,30" MaxWidth="980" HorizontalAlignment="Left">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Profiles" Style="{StaticResource PageTitleStyle}" />
                <Border Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="9,4"
                        Margin="10,1,0,0"
                        VerticalAlignment="Top">
                  <TextBlock Text="Unsaved changes" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                </Border>
              </StackPanel>
              <TextBlock Text="A profile is the one-click sequence of tools you want NGR to launch together."
                         Style="{StaticResource SecondaryTextStyle}"
                         Margin="0,5,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Style="{StaticResource PrimaryButtonStyle}" Margin="1" VerticalAlignment="Bottom">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource CodiconSave}" Style="{StaticResource ButtonIconStyle}" Margin="0,0,8,0" />
                <TextBlock Text="Save changes" />
              </StackPanel>
            </Button>
          </Grid>

          <Border Grid.Row="1" Style="{StaticResource EditorSectionStyle}" Margin="0,22,0,14">
            <StackPanel>
              <TextBlock Text="Profile name" Style="{StaticResource LabelStyle}" />
              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxWidth="520" HorizontalAlignment="Left" />
              <TextBlock Text="NGR manages the internal profile identifier automatically."
                         Style="{StaticResource SecondaryTextStyle}"
                         FontSize="11"
                         Margin="2,7,0,0" />
            </StackPanel>
          </Border>

          <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="PROFILE CHECK" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,6" />
              <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </Border>

          <Border Grid.Row="3" Style="{StaticResource EditorSectionStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Grid Margin="0,0,0,13">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="LAUNCH STEPS" Style="{StaticResource SidebarHeaderStyle}" />
                  <TextBlock Text="Choose a tool, add it, then arrange the list from top to bottom. Delay happens before each tool starts."
                             Style="{StaticResource SecondaryTextStyle}"
                             FontSize="11"
                             Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Command="{Binding MoveStepUpCommand}" Style="{StaticResource IconButtonStyle}" Margin="1,0,8,0" ToolTip="Move selected step up">
                    <Path Data="{StaticResource CodiconChevronUp}" Style="{StaticResource ButtonIconStyle}" />
                  </Button>
                  <Button Command="{Binding MoveStepDownCommand}" Style="{StaticResource IconButtonStyle}" Margin="1,0,8,0" ToolTip="Move selected step down">
                    <Path Data="{StaticResource CodiconChevronDown}" Style="{StaticResource ButtonIconStyle}" />
                  </Button>
                  <Button Command="{Binding RemoveStepCommand}" Style="{StaticResource ToolbarButtonStyle}" Foreground="#F06A6A" Margin="1">
                    <StackPanel Orientation="Horizontal">
                      <Path Data="{StaticResource CodiconTrash}" Style="{StaticResource ButtonIconStyle}" Margin="0,0,7,0" />
                      <TextBlock Text="Remove" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>

              <Border Grid.Row="1" Visibility="{Binding HasNoAvailableTools, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,11">
                <StackPanel>
                  <TextBlock Text="No tools available" FontWeight="SemiBold" />
                  <TextBlock Text="Open Tool Library, choose an installed app or create a command, test it, save it, then return here."
                             Style="{StaticResource SecondaryTextStyle}"
                             Margin="0,5,0,0"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Grid.Row="1" Visibility="{Binding HasAvailableTools, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox ItemsSource="{Binding AvailableTools}" SelectedItem="{Binding ToolToAdd}" DisplayMemberPath="Name" MinWidth="260" />
                  <Button Grid.Column="2" Command="{Binding AddStepCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="1">
                    <StackPanel Orientation="Horizontal">
                      <Path Data="{StaticResource CodiconAdd}" Style="{StaticResource ButtonIconStyle}" Margin="0,0,7,0" />
                      <TextBlock Text="Add tool" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>

              <Border Grid.Row="2" Visibility="{Binding HasNoSteps, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel>
                  <TextBlock Text="No launch steps yet" FontWeight="SemiBold" />
                  <TextBlock Text="Choose a tool above and click Add tool. The list you build here is the exact launch order."
                             Style="{StaticResource SecondaryTextStyle}"
                             Margin="0,5,0,0"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Grid.Row="2" Visibility="{Binding HasSteps, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="5" ClipToBounds="True">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid Margin="10,7,10,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TOOL" Style="{StaticResource SidebarHeaderStyle}" />
                    <TextBlock Grid.Column="1" Text="DELAY BEFORE LAUNCH" Style="{StaticResource SidebarHeaderStyle}" />
                  </Grid>
                  <ListBox Grid.Row="1" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem" BasedOn="{StaticResource SidebarListItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="2,2" />
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="3,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                          </Grid.ColumnDefinitions>
                          <ComboBox ItemsSource="{Binding DataContext.AvailableTools, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    DisplayMemberPath="Name"
                                    SelectedValuePath="Id"
                                    SelectedValue="{Binding ToolId, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,12,0"
                                    MinHeight="32" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Text="{Binding DelayBeforeSeconds, UpdateSourceTrigger=PropertyChanged}" Width="78" MinHeight="32" HorizontalContentAlignment="Right" />
                            <TextBlock Text="seconds" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Style="{StaticResource SecondaryTextStyle}" Margin="2,13,0,0" TextWrapping="Wrap" />
        </Grid>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate x:Key="SettingsEditorTemplate" DataType="{x:Type vm:SettingsViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24,28,30" MaxWidth="820" HorizontalAlignment="Left">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
              <TextBlock Text="Appearance and Windows integration." Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="1" VerticalAlignment="Bottom">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource CodiconSave}" Style="{StaticResource ButtonIconStyle}" Margin="0,0,8,0" />
                <TextBlock Text="Save settings" />
              </StackPanel>
            </Button>
          </Grid>

          <Border Grid.Row="1" Style="{StaticResource EditorSectionStyle}" Margin="0,22,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Choose the light/dark behavior for the entire app and native title bar."
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,5,24,0" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Theme" Style="{StaticResource LabelStyle}" />
                <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="240" HorizontalAlignment="Left" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="2" Style="{StaticResource EditorSectionStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Start with Windows" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Uses the current-user Windows Run entry."
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,5,24,0" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <CheckBox Content="Start NGR Launcher when I sign in" IsChecked="{Binding StartWithWindows}" />
                <TextBlock Text="When enabled, NGR starts hidden in the tray and never auto-runs a profile."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,9,0,0"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Style="{StaticResource SecondaryTextStyle}" Margin="2,13,0,0" TextWrapping="Wrap" />
        </Grid>
      </ScrollViewer>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
      <RowDefinition Height="26" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Image Source="/Assets/NgrLauncher.ico" Width="27" Height="27" Stretch="Uniform" VerticalAlignment="Center" Margin="2,0,10,0" />

        <Menu Grid.Column="1" VerticalAlignment="Stretch">
          <MenuItem Header="View">
            <MenuItem Header="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
            <MenuItem Header="Tool Library" Command="{Binding NavigateCommand}" CommandParameter="Tools" />
            <MenuItem Header="Profiles" Command="{Binding NavigateCommand}" CommandParameter="Profiles" />
            <Separator />
            <MenuItem Header="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
          </MenuItem>
          <MenuItem Header="Run">
            <MenuItem Header="Run selected profile" Command="{Binding Dashboard.LaunchCommand}" />
            <MenuItem Header="Cancel pending steps" Command="{Binding Dashboard.CancelCommand}" />
          </MenuItem>
        </Menu>

        <TextBlock Grid.Column="2" Text="NGR Launcher" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding CurrentTitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,4,0" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="54" />
        <ColumnDefinition Width="270" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,6">
            <Button Command="{Binding NavigateCommand}" CommandParameter="Settings" ToolTip="Settings">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ActivityButtonStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentTitle}" Value="Settings"><Setter Property="Tag" Value="Active" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <Path Data="{StaticResource CodiconSettings}" Style="{StaticResource ButtonIconStyle}" Width="22" Height="22" />
            </Button>
          </StackPanel>
          <StackPanel Margin="0,6,0,0">
            <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard" ToolTip="Dashboard">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ActivityButtonStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentTitle}" Value="Dashboard"><Setter Property="Tag" Value="Active" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <Path Data="{StaticResource CodiconHome}" Style="{StaticResource ButtonIconStyle}" Width="22" Height="22" />
            </Button>
            <Button Command="{Binding NavigateCommand}" CommandParameter="Tools" ToolTip="Tool Library">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ActivityButtonStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentTitle}" Value="Tool Library"><Setter Property="Tag" Value="Active" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <Path Data="{StaticResource CodiconTools}" Style="{StaticResource ButtonIconStyle}" Width="22" Height="22" />
            </Button>
            <Button Command="{Binding NavigateCommand}" CommandParameter="Profiles" ToolTip="Profiles">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ActivityButtonStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentTitle}" Value="Profiles"><Setter Property="Tag" Value="Active" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <Path Data="{StaticResource CodiconLibrary}" Style="{StaticResource ButtonIconStyle}" Width="22" Height="22" />
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
        <ContentControl Content="{Binding CurrentPage}">
          <ContentControl.Resources>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource DashboardSidebarTemplate}" /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ToolLibraryViewModel}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolsSidebarTemplate}" /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfilesViewModel}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProfilesSidebarTemplate}" /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource SettingsSidebarTemplate}" /></DataTemplate>
          </ContentControl.Resources>
        </ContentControl>
      </Border>

      <Grid Grid.Column="2" Background="{DynamicResource ApplicationBackgroundBrush}">
        <ContentControl Content="{Binding CurrentPage}">
          <ContentControl.Resources>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource DashboardEditorTemplate}" /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ToolLibraryViewModel}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolsEditorTemplate}" /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfilesViewModel}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProfilesEditorTemplate}" /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource SettingsEditorTemplate}" /></DataTemplate>
          </ContentControl.Resources>
        </ContentControl>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse Width="6" Height="6" Fill="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="Ready" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,14,0" />
        <TextBlock Grid.Column="3" Text="{Binding CurrentTitle}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,14,0" />
        <TextBlock Grid.Column="4" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="10.5" VerticalAlignment="Center">
          <Run Text="Theme: " /><Run Text="{Binding Settings.Theme}" />
        </TextBlock>
      </Grid>
    </Border>
  </Grid>
</Window>
