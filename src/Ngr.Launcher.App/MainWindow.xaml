<Window x:Class="Ngr.Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Ngr.Launcher.App.ViewModels"
        Title="NGR Launcher"
        Width="1280"
        Height="820"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <DataTemplate x:Key="DashboardSidebarTemplate" DataType="{x:Type vm:DashboardViewModel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="44" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
          <TextBlock Text="RUN PROFILES"
                     Style="{StaticResource SidebarHeaderStyle}"
                     VerticalAlignment="Center"
                     Margin="14,0" />
        </Border>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Profiles}"
                 SelectedItem="{Binding SelectedProfile}"
                 DisplayMemberPath="Name"
                 ItemContainerStyle="{StaticResource SidebarListItemStyle}"
                 Margin="0,4" />

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="10">
          <Button Command="{Binding LaunchCommand}"
                  Style="{StaticResource PrimaryButtonStyle}"
                  HorizontalAlignment="Stretch"
                  ToolTip="Run selected profile">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Path Data="{StaticResource CodiconPlay}"
                    Style="{StaticResource ButtonIconStyle}"
                    Margin="0,0,7,0" />
              <TextBlock Text="Run selected" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ToolsSidebarTemplate" DataType="{x:Type vm:ToolLibraryViewModel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="44" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
          <Grid Margin="10,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="TOOLS"
                       Style="{StaticResource SidebarHeaderStyle}"
                       VerticalAlignment="Center"
                       Margin="4,0" />
            <Button Grid.Column="1"
                    Command="{Binding NewCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    Margin="0,5,5,5"
                    ToolTip="New tool">
              <Path Data="{StaticResource CodiconAdd}" Style="{StaticResource ButtonIconStyle}" />
            </Button>
            <Button Grid.Column="2"
                    Command="{Binding DeleteCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    Foreground="#F06A6A"
                    Margin="0,5,0,5"
                    ToolTip="Delete selected tool">
              <Path Data="{StaticResource CodiconTrash}" Style="{StaticResource ButtonIconStyle}" />
            </Button>
          </Grid>
        </Border>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Tools}"
                 SelectedItem="{Binding SelectedTool}"
                 DisplayMemberPath="Name"
                 ItemContainerStyle="{StaticResource SidebarListItemStyle}"
                 Margin="0,4" />

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="12">
          <StackPanel>
            <TextBlock Text="TEMPLATE" Style="{StaticResource SidebarHeaderStyle}" Margin="2,0,0,7" />
            <ComboBox ItemsSource="{Binding Templates}"
                      SelectedItem="{Binding SelectedTemplate}"
                      DisplayMemberPath="Name"
                      Margin="0,0,0,8" />
            <Button Command="{Binding ApplyTemplateCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    HorizontalAlignment="Stretch">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="{StaticResource CodiconAdd}"
                      Style="{StaticResource ButtonIconStyle}"
                      Margin="0,0,7,0" />
                <TextBlock Text="Apply template" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ProfilesSidebarTemplate" DataType="{x:Type vm:ProfilesViewModel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="44" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
          <Grid Margin="10,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="PROFILES"
                       Style="{StaticResource SidebarHeaderStyle}"
                       VerticalAlignment="Center"
                       Margin="4,0" />
            <Button Grid.Column="1"
                    Command="{Binding NewCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    Margin="0,5,5,5"
                    ToolTip="New profile">
              <Path Data="{StaticResource CodiconAdd}" Style="{StaticResource ButtonIconStyle}" />
            </Button>
            <Button Grid.Column="2"
                    Command="{Binding DeleteCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    Foreground="#F06A6A"
                    Margin="0,5,0,5"
                    ToolTip="Delete selected profile">
              <Path Data="{StaticResource CodiconTrash}" Style="{StaticResource ButtonIconStyle}" />
            </Button>
          </Grid>
        </Border>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Profiles}"
                 SelectedItem="{Binding SelectedProfile}"
                 DisplayMemberPath="Name"
                 ItemContainerStyle="{StaticResource SidebarListItemStyle}"
                 Margin="0,4" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SettingsSidebarTemplate" DataType="{x:Type vm:SettingsViewModel}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="44" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
          <TextBlock Text="SETTINGS"
                     Style="{StaticResource SidebarHeaderStyle}"
                     VerticalAlignment="Center"
                     Margin="14,0" />
        </Border>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="14">
          <StackPanel>
            <TextBlock Text="APPEARANCE" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,7" />
            <TextBlock Text="{Binding Theme}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          </StackPanel>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="14">
          <StackPanel>
            <TextBlock Text="STARTUP" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,7" />
            <TextBlock Text="Windows startup wiring is not implemented yet."
                       Style="{StaticResource SecondaryTextStyle}" />
          </StackPanel>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DashboardEditorTemplate" DataType="{x:Type vm:DashboardViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="26,24,26,28">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />
              <TextBlock Text="Launch profiles, watch active runs, and cancel pending steps."
                         Style="{StaticResource SecondaryTextStyle}"
                         Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
              <Button Command="{Binding CancelCommand}"
                      Style="{StaticResource ToolbarButtonStyle}"
                      Margin="0,0,8,0"
                      Content="Cancel selected" />
              <Button Command="{Binding LaunchCommand}"
                      Style="{StaticResource PrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource CodiconPlay}"
                        Style="{StaticResource ButtonIconStyle}"
                        Margin="0,0,7,0" />
                  <TextBlock Text="Run profile" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <Border Grid.Row="1"
                  Style="{StaticResource EditorSectionStyle}"
                  Margin="0,22,0,18">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Selected profile"
                         Style="{StaticResource LabelStyle}"
                         VerticalAlignment="Center"
                         Margin="0,0,14,0" />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding Profiles}"
                        SelectedItem="{Binding SelectedProfile}"
                        DisplayMemberPath="Name"
                        MinWidth="280"
                        HorizontalAlignment="Left" />
              <TextBlock Grid.Column="2"
                         Text="{Binding StatusMessage}"
                         Style="{StaticResource SecondaryTextStyle}"
                         VerticalAlignment="Center"
                         Margin="18,0,0,0" />
            </Grid>
          </Border>

          <TextBlock Grid.Row="2"
                     Text="RECENT RUNS"
                     Style="{StaticResource SidebarHeaderStyle}"
                     Margin="2,0,0,9" />

          <ListBox Grid.Row="3"
                   ItemsSource="{Binding Sessions}"
                   SelectedItem="{Binding SelectedSession}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Root"
                              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              CornerRadius="10"
                              Padding="16">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                          <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" FontSize="14" />
                    <Border Grid.Column="1"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="7"
                            Padding="8,3">
                      <TextBlock Text="{Binding Status}"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 FontSize="11.5" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding Id}"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             FontSize="10.5"
                             Margin="0,3,0,9" />
                  <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="2*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding ToolName}" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding DelayBeforeSeconds, StringFormat={}{0}s}"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                          <TextBlock Grid.Column="2" Text="{Binding Status}" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="3"
                                     Text="{Binding Error}"
                                     Foreground="#F06A6A"
                                     TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate x:Key="ToolsEditorTemplate" DataType="{x:Type vm:ToolLibraryViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="26,24,26,28">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Tool editor" Style="{StaticResource PageTitleStyle}" />
              <TextBlock Text="Configure an application or command. Saved tools stay reusable across profiles."
                         Style="{StaticResource SecondaryTextStyle}"
                         Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
              <Button Command="{Binding LaunchCommand}"
                      Style="{StaticResource ToolbarButtonStyle}"
                      Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource CodiconPlay}"
                        Style="{StaticResource ButtonIconStyle}"
                        Margin="0,0,7,0" />
                  <TextBlock Text="Run now" />
                </StackPanel>
              </Button>
              <Button Command="{Binding SaveCommand}"
                      Style="{StaticResource PrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource CodiconSave}"
                        Style="{StaticResource ButtonIconStyle}"
                        Margin="0,0,7,0" />
                  <TextBlock Text="Save tool" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <Border Grid.Row="1"
                  Style="{StaticResource EditorSectionStyle}"
                  Margin="0,22,0,14">
            <StackPanel>
              <TextBlock Text="IDENTITY" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,13" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Text="ID" Style="{StaticResource LabelStyle}" />
                  <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Name" Style="{StaticResource LabelStyle}" />
                  <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,13,0,0">
                  <TextBlock Text="Kind" Style="{StaticResource LabelStyle}" />
                  <ComboBox ItemsSource="{Binding ToolKinds}" SelectedItem="{Binding Kind}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,13,0,0">
                  <TextBlock Text="Working directory" Style="{StaticResource LabelStyle}" />
                  <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource EditorSectionStyle}">
              <StackPanel>
                <TextBlock Text="APPLICATION" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,13" />
                <TextBlock Text="Target" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,13" />
                <TextBlock Text="Arguments" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource EditorSectionStyle}">
              <StackPanel>
                <TextBlock Text="COMMAND" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,13" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Shell" Style="{StaticResource LabelStyle}" />
                    <ComboBox ItemsSource="{Binding ShellKinds}" SelectedItem="{Binding Shell}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Window mode" Style="{StaticResource LabelStyle}" />
                    <ComboBox ItemsSource="{Binding WindowModes}" SelectedItem="{Binding WindowMode}" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="Command" Style="{StaticResource LabelStyle}" Margin="0,13,0,0" />
                <TextBox Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                         Height="86"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top" />
                <TextBlock Text="Environment (KEY=VALUE, one per line)"
                           Style="{StaticResource LabelStyle}"
                           Margin="0,13,0,0" />
                <TextBox Text="{Binding EnvironmentText, UpdateSourceTrigger=PropertyChanged}"
                         Height="104"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" />
              </StackPanel>
            </Border>
          </Grid>

          <TextBlock Grid.Row="3"
                     Text="{Binding StatusMessage}"
                     Style="{StaticResource SecondaryTextStyle}"
                     Margin="2,13,0,0" />
        </Grid>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate x:Key="ProfilesEditorTemplate" DataType="{x:Type vm:ProfilesViewModel}">
      <Grid Margin="26,24,26,28">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Profile editor" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Order reusable tools and set a delay before each launch."
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,5,0,0" />
          </StackPanel>
          <Button Grid.Column="1"
                  Command="{Binding SaveCommand}"
                  Style="{StaticResource PrimaryButtonStyle}"
                  VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource CodiconSave}"
                    Style="{StaticResource ButtonIconStyle}"
                    Margin="0,0,7,0" />
              <TextBlock Text="Save profile" />
            </StackPanel>
          </Button>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource EditorSectionStyle}"
                Margin="0,22,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="ID" Style="{StaticResource LabelStyle}" />
              <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Name" Style="{StaticResource LabelStyle}" />
              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource EditorSectionStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,11">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="STEPS" Style="{StaticResource SidebarHeaderStyle}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding AddStepCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,0,6,0">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource CodiconAdd}"
                          Style="{StaticResource ButtonIconStyle}"
                          Margin="0,0,6,0" />
                    <TextBlock Text="Add step" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding MoveStepUpCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        Margin="0,0,6,0"
                        ToolTip="Move selected step up">
                  <Path Data="{StaticResource CodiconChevronUp}" Style="{StaticResource ButtonIconStyle}" />
                </Button>
                <Button Command="{Binding MoveStepDownCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        Margin="0,0,6,0"
                        ToolTip="Move selected step down">
                  <Path Data="{StaticResource CodiconChevronDown}" Style="{StaticResource ButtonIconStyle}" />
                </Button>
                <Button Command="{Binding RemoveStepCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Foreground="#F06A6A">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource CodiconTrash}"
                          Style="{StaticResource ButtonIconStyle}"
                          Margin="0,0,6,0" />
                    <TextBlock Text="Remove" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True">
              <DataGrid ItemsSource="{Binding Steps}"
                        SelectedItem="{Binding SelectedStep}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Tool" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <ComboBox ItemsSource="{Binding DataContext.AvailableTools, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding ToolId, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0"
                                  MinHeight="30" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Delay before launch (seconds)"
                                      Width="220"
                                      Binding="{Binding DelayBeforeSeconds, UpdateSourceTrigger=PropertyChanged}" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource SecondaryTextStyle}"
                   Margin="2,13,0,0" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SettingsEditorTemplate" DataType="{x:Type vm:SettingsViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="26,24,26,28">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
              <TextBlock Text="Appearance and Windows integration preferences."
                         Style="{StaticResource SecondaryTextStyle}"
                         Margin="0,5,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    VerticalAlignment="Bottom">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource CodiconSave}"
                      Style="{StaticResource ButtonIconStyle}"
                      Margin="0,0,7,0" />
                <TextBlock Text="Save settings" />
              </StackPanel>
            </Button>
          </Grid>

          <Border Grid.Row="1"
                  Style="{StaticResource EditorSectionStyle}"
                  Margin="0,22,0,14"
                  MaxWidth="760"
                  HorizontalAlignment="Left">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Choose how NGR follows Windows colors."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,5,22,0" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Theme" Style="{StaticResource LabelStyle}" />
                <ComboBox ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding Theme}"
                          Width="240"
                          HorizontalAlignment="Left" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="2"
                  Style="{StaticResource EditorSectionStyle}"
                  MaxWidth="760"
                  HorizontalAlignment="Left">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Startup" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Windows startup integration."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,5,22,0" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <CheckBox Content="Start NGR Launcher with Windows"
                          IsChecked="{Binding StartWithWindows}" />
                <TextBlock Text="The preference is saved, but Windows startup registration is not wired yet."
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,9,0,0" />
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Grid.Row="3"
                     Text="{Binding StatusMessage}"
                     Style="{StaticResource SecondaryTextStyle}"
                     Margin="2,13,0,0" />
        </Grid>
      </ScrollViewer>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="34" />
      <RowDefinition Height="*" />
      <RowDefinition Height="24" />
    </Grid.RowDefinitions>

    <!-- Menu/title bar -->
    <Border Grid.Row="0"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="26"
                Height="26"
                CornerRadius="8"
                Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ToolTip="NGR Launcher">
          <Path Data="{StaticResource CodiconPlay}"
                Width="14"
                Height="14"
                Stretch="Uniform"
                Fill="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>

        <Menu Grid.Column="1" VerticalAlignment="Stretch">
          <MenuItem Header="View">
            <MenuItem Header="Dashboard"
                      Command="{Binding NavigateCommand}"
                      CommandParameter="Dashboard" />
            <MenuItem Header="Tool Library"
                      Command="{Binding NavigateCommand}"
                      CommandParameter="Tools" />
            <MenuItem Header="Profiles"
                      Command="{Binding NavigateCommand}"
                      CommandParameter="Profiles" />
            <Separator />
            <MenuItem Header="Settings"
                      Command="{Binding NavigateCommand}"
                      CommandParameter="Settings" />
          </MenuItem>
          <MenuItem Header="Run">
            <MenuItem Header="Run selected profile"
                      Command="{Binding Dashboard.LaunchCommand}" />
            <MenuItem Header="Cancel selected run"
                      Command="{Binding Dashboard.CancelCommand}" />
          </MenuItem>
        </Menu>

        <TextBlock Grid.Column="2"
                   Text="NGR Launcher"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   FontSize="11.5"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center" />

        <Border Grid.Column="3"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="7"
                Padding="8,3"
                Margin="0,5,10,5">
          <TextBlock Text="{Binding CurrentTitle}"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     FontSize="11"
                     VerticalAlignment="Center" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="52" />
        <ColumnDefinition Width="252" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Activity bar -->
      <Border Grid.Column="0"
              Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,5">
            <Button Command="{Binding NavigateCommand}"
                    CommandParameter="Settings"
                    ToolTip="Settings">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ActivityButtonStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentTitle}" Value="Settings">
                      <Setter Property="Tag" Value="Active" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <Path Data="{StaticResource CodiconSettings}"
                    Style="{StaticResource ButtonIconStyle}"
                    Width="22"
                    Height="22" />
            </Button>
          </StackPanel>

          <StackPanel Margin="0,5,0,0">
            <Button Command="{Binding NavigateCommand}"
                    CommandParameter="Dashboard"
                    ToolTip="Dashboard">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ActivityButtonStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentTitle}" Value="Dashboard">
                      <Setter Property="Tag" Value="Active" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <Path Data="{StaticResource CodiconHome}"
                    Style="{StaticResource ButtonIconStyle}"
                    Width="22"
                    Height="22" />
            </Button>

            <Button Command="{Binding NavigateCommand}"
                    CommandParameter="Tools"
                    ToolTip="Tool Library">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ActivityButtonStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentTitle}" Value="Tool Library">
                      <Setter Property="Tag" Value="Active" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <Path Data="{StaticResource CodiconTools}"
                    Style="{StaticResource ButtonIconStyle}"
                    Width="22"
                    Height="22" />
            </Button>

            <Button Command="{Binding NavigateCommand}"
                    CommandParameter="Profiles"
                    ToolTip="Profiles">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ActivityButtonStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentTitle}" Value="Profiles">
                      <Setter Property="Tag" Value="Active" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <Path Data="{StaticResource CodiconLibrary}"
                    Style="{StaticResource ButtonIconStyle}"
                    Width="22"
                    Height="22" />
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Context sidebar -->
      <Border Grid.Column="1"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0">
        <ContentControl Content="{Binding CurrentPage}">
          <ContentControl.Resources>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DashboardSidebarTemplate}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ToolLibraryViewModel}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolsSidebarTemplate}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProfilesSidebarTemplate}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SettingsSidebarTemplate}" />
            </DataTemplate>
          </ContentControl.Resources>
        </ContentControl>
      </Border>

      <!-- Editor area -->
      <Grid Grid.Column="2" Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="38" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                    BorderThickness="0,2,0,0"
                    CornerRadius="8,8,0,0"
                    Padding="14,0"
                    Margin="5,4,0,0"
                    MinWidth="150">
              <TextBlock Text="{Binding CurrentTitle}"
                         VerticalAlignment="Center"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </Border>

            <TextBlock Grid.Column="1"
                       Text="Local workspace"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="14,0" />

            <Button Grid.Column="2"
                    Command="{Binding Dashboard.LaunchCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Margin="0,4,8,4"
                    Padding="10,3"
                    ToolTip="Run selected profile">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource CodiconPlay}"
                      Style="{StaticResource ButtonIconStyle}"
                      Margin="0,0,6,0" />
                <TextBlock Text="Run" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}">
          <ContentControl.Resources>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DashboardEditorTemplate}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ToolLibraryViewModel}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ToolsEditorTemplate}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProfilesEditorTemplate}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SettingsEditorTemplate}" />
            </DataTemplate>
          </ContentControl.Resources>
        </ContentControl>
      </Grid>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Background="{DynamicResource SystemAccentColorPrimaryBrush}">
      <Grid Margin="9,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Ellipse Width="6"
                 Height="6"
                 Fill="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                 VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="NGR"
                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="6,0,12,0" />

        <TextBlock Grid.Column="2"
                   Text="Local workspace"
                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                   Opacity="0.88"
                   FontSize="10.5"
                   VerticalAlignment="Center" />

        <TextBlock Grid.Column="3"
                   Text="{Binding CurrentTitle}"
                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                   Opacity="0.88"
                   FontSize="10.5"
                   VerticalAlignment="Center"
                   Margin="0,0,14,0" />

        <TextBlock Grid.Column="4"
                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                   Opacity="0.88"
                   FontSize="10.5"
                   VerticalAlignment="Center">
          <Run Text="Theme: " />
          <Run Text="{Binding Settings.Theme}" />
        </TextBlock>
      </Grid>
    </Border>
  </Grid>
</Window>
