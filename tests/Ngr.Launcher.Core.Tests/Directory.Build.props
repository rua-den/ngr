<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildThisFileDirectory)Execution\CommandLogBehaviorTests.cs;$(MSBuildThisFileDirectory)Execution\SystemCommandSpawnerIntegrationTests.cs</DefaultItemExcludes>
  </PropertyGroup>
</Project>
